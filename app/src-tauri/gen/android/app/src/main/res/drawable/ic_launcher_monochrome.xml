<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer, used when the launcher tints every icon with the
  wallpaper palette (Android 13+). The system keeps the alpha and drops the
  colours. The sun and the horizon stay opaque. The two lower lines fade to
  half.

  Same geometry and same group transform as `ic_launcher_foreground.xml`. If
  one moves, move both.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:scaleX="0.8567"
        android:scaleY="0.8567"
        android:translateX="73.4"
        android:translateY="-8.9">
        <path
            android:pathData="M 292 592 A 220 220 0 0 1 732 592 Z"
            android:fillColor="#ffffff" />
        <path
            android:pathData="M 212 592 H 812"
            android:strokeColor="#ffffff"
            android:strokeWidth="64"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 312 712 H 712"
            android:strokeColor="#ffffff"
            android:strokeAlpha="0.5"
            android:strokeWidth="56"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 412 816 H 612"
            android:strokeColor="#ffffff"
            android:strokeAlpha="0.5"
            android:strokeWidth="56"
            android:strokeLineCap="round" />
    </group>
</vector>
