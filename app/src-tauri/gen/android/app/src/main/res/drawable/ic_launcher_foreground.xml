<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer of the adaptive launcher icon: the gauge from
  `src-tauri/icons/icon.svg`, minus the rounded-square plate (that's the
  background layer's job now).

  Hand-written, and `pnpm tauri icon` does not touch it. That command only
  writes the raster mipmaps, and the one it calls `ic_launcher_foreground.png`
  is the full-bleed artwork — correct as a legacy icon, wrong as a foreground,
  because a launcher masks this layer down to the middle 72 of 108dp and would
  cut the arc's shoulders off.

  The viewport is the artwork's own 1024 grid so the two paths below are
  verbatim copies of the SVG. The group shrinks that grid until the gauge —
  696 units across, being 2 × (r 300 + half of the 96 stroke) — lands at 54dp:

      scale     = (54 / 108) × 1024 / 696 = 0.7356
      translate = (1024 − 1024 × 0.7356) / 2 = 135.4

  That's three quarters of the 72dp a mask shows, and clear of the 66dp circle
  Android guarantees. It reads a shade bigger than the mark does on the desktop
  plate, which is deliberate: a round mask eats the corner air a rounded square
  gives away for free, so matching the ratio exactly would look shrunken.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:scaleX="0.7356"
        android:scaleY="0.7356"
        android:translateX="135.4"
        android:translateY="135.4">
        <!-- Track: 135° → 405°, the unfilled remainder of the gauge. -->
        <path
            android:pathData="M 299.87 724.13 A 300 300 0 1 1 724.13 724.13"
            android:strokeColor="#4a453c"
            android:strokeWidth="96"
            android:strokeLineCap="round" />
        <!-- Fill: the same arc stopped at 62%, in accent. -->
        <path
            android:pathData="M 299.87 724.13 A 300 300 0 0 1 672.70 258.70"
            android:strokeColor="#c97354"
            android:strokeWidth="96"
            android:strokeLineCap="round" />
    </group>
</vector>
