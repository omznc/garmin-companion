<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer of the adaptive launcher icon: the Horizon mark from
  `src-tauri/icons/icon.svg`, minus the rounded-square tile (the background
  layer draws the colour).

  Written by hand. `pnpm tauri icon` does not touch it. The viewport is the
  1024 grid of the artwork, so the four paths are copies of the SVG. The group
  scales the grid so the mark is 60dp wide and sits in the centre. The launcher
  shows the middle 72dp of the 108dp, and Android keeps the middle 66dp safe.

      scale       = (60 / 108) x 1024 / 664 = 0.8567
      translate x = 512 x (1 - 0.8567)      = 73.4
      translate y = 512 - 608 x 0.8567      = -8.9

  The mark spans x 180 to 844 and y 372 to 844 in the grid. Its centre is
  (512, 608).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:scaleX="0.8567"
        android:scaleY="0.8567"
        android:translateX="73.4"
        android:translateY="-8.9">
        <path
            android:pathData="M 292 592 A 220 220 0 0 1 732 592 Z"
            android:fillColor="#c97354" />
        <path
            android:pathData="M 212 592 H 812"
            android:strokeColor="#ede8de"
            android:strokeWidth="64"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 312 712 H 712"
            android:strokeColor="#4a453c"
            android:strokeWidth="56"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 412 816 H 612"
            android:strokeColor="#4a453c"
            android:strokeWidth="56"
            android:strokeLineCap="round" />
    </group>
</vector>
