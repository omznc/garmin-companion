{
  "expo": {
    "name": "Garmin Companion",
    "slug": "garmin-companion",
    "version": "0.1.0",
    "scheme": "garmincompanion",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.omznc.garmincompanion",
      "supportsTablet": false
    },
    "android": {
      "package": "com.omznc.garmincompanion",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": { "buildArchs": ["arm64-v8a", "x86_64"], "minSdkVersion": 29 }
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
