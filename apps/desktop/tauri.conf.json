{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garmin Companion",
  "mainBinaryName": "garmin-companion",
  "version": "1.0.5",
  "identifier": "com.omznc.garmincompanion",
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["garmin-companion-login"],
    "publisher": "Omar Žunić",
    "homepage": "https://github.com/omznc/garmin-companion",
    "shortDescription": "Your Garmin data, read by a coach that remembers.",
    "longDescription": "Reads your Garmin Connect activities, heart-rate zones, cadence and recovery into a local cache, and answers questions about your training against them. Everything stays on your machine except the metrics a question needs.",
    "category": "HealthcareFitness",
    "copyright": "© Omar Žunić",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "icon": [
      "../../app/src-tauri/icons/32x32.png",
      "../../app/src-tauri/icons/64x64.png",
      "../../app/src-tauri/icons/128x128.png",
      "../../app/src-tauri/icons/icon.png",
      "../../app/src-tauri/icons/icon.icns",
      "../../app/src-tauri/icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libxkbcommon-x11-0",
          "libwebkit2gtk-4.1-0", "libgtk-3-0"
        ],
        "recommends": ["libvulkan1"],
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "../../app/src-tauri/linux/garmin-companion.desktop",
        "files": {
          "/usr/share/metainfo/com.omznc.garmincompanion.metainfo.xml": "../../app/src-tauri/linux/com.omznc.garmincompanion.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "libxkbcommon-x11",
          "webkit2gtk4.1", "gtk3"
        ],
        "recommends": ["vulkan-loader"],
        "desktopTemplate": "../../app/src-tauri/linux/garmin-companion.desktop",
        "files": {
          "/usr/share/metainfo/com.omznc.garmincompanion.metainfo.xml": "../../app/src-tauri/linux/com.omznc.garmincompanion.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.omznc.garmincompanion.metainfo.xml": "../../app/src-tauri/linux/com.omznc.garmincompanion.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/omznc/garmin-companion/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRDgyNjA4RjUwNDlBMzcKUldRM21nVDFDQ2JZUSt1eDU2MHBOMEVLTG9zQXFkd0gzTy8xeW1tbnQ2RmFrdmtqc1pObU5JSnAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
